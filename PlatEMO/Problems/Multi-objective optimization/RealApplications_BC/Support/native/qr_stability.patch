+// Local fixed-input RGB bridge; options match Python read_barcode defaults.
+#include <cstdio>
+extern "C" __attribute__((visibility("default")))
+int realapps_qr_matches(const uint8_t* pixels, int width, int height, int stride,
+                        const char* expected, char* error, int error_size)
+{
+    try {
+        const auto options = ReaderOptions().formats(BarcodeFormat::QRCode)
+            .tryRotate(true).tryDownscale(true).tryInvert(true).textMode(TextMode::HRI)
+            .binarizer(Binarizer::LocalAverage).isPure(false).maxNumberOfSymbols(1)
+            .eanAddOnSymbol(EanAddOnSymbol::Ignore).returnErrors(false);
+        auto results = ReadBarcodes(ImageView(pixels,width,height,ImageFormat::RGB,stride),options);
+        return !results.empty() && results.front().text() == expected;
+    } catch (const std::exception& e) {
+        std::snprintf(error,error_size,"%s",e.what());return -1;
+    }
 }
