+    updateCount = max(0,round(double(dPretrain))) + ...
+        max(0,round(double(ganIter))) * ...
+        (max(1,round(double(dSteps))) + max(1,round(double(gSteps))));
+    Reuse = updateCount*miniBatch/trainCount;
+end
