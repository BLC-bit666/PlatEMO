diff --git a/PlatEMO/Algorithms/Multi-objective optimization/CBS-CGAN/test_CBS_region_gan_branches.m b/PlatEMO/Algorithms/Multi-objective optimization/CBS-CGAN/test_CBS_region_gan_branches.m
