+function History = emptyTrainingHistory()
+    History = struct( ...
+        'step',{}, ...
+        'loss_d',{}, ...
+        'loss_g',{}, ...
+        'd_real_acc',{}, ...
+        'd_fake_acc',{}, ...
+        'd_bal_acc',{}, ...
+        'g_fool_rate',{}, ...
+        'score_real_mean',{}, ...
+        'score_fake_mean',{}, ...
+        'score_random_mean',{}, ...
+        'random_as_fake_rate',{});
+end
+
+function GAN = appendTrainingHistory(GAN,XScaled,TrainC,DiagZ, ...
+        DiagRandomScaled,Options,step)
+    Row = evaluateTrainingHistory(GAN,XScaled,TrainC,DiagZ, ...
+        DiagRandomScaled,Options,step);
+    GAN.train_history(end+1) = Row;
+    GAN.last_discriminator_loss = Row.loss_d;
+    GAN.last_generator_loss = Row.loss_g;
+    GAN.last_d_real_acc = Row.d_real_acc;
+    GAN.last_d_fake_acc = Row.d_fake_acc;
+    GAN.last_d_bal_acc = Row.d_bal_acc;
+    GAN.last_g_fool_rate = Row.g_fool_rate;
+    GAN.last_score_real = Row.score_real_mean;
+    GAN.last_score_fake = Row.score_fake_mean;
+    GAN.last_score_random = Row.score_random_mean;
+    GAN.last_random_as_fake_rate = Row.random_as_fake_rate;
+end
+
+function Row = evaluateTrainingHistory(GAN,XScaled,TrainC,DiagZ, ...
+        DiagRandomScaled,Options,step)
+    dlX = dlarray(single(XScaled'),'CB');
+    dlC = dlarray(single(TrainC'),'CB');
+    dlZ = dlarray(single(DiagZ'),'CB');
+    dlRandom = dlarray(single(DiagRandomScaled'),'CB');
+    dlFake = forward(GAN.netG,[dlZ;dlC]);
+    scoreReal = forward(GAN.netD,[dlX;dlC]);
+    scoreFake = forward(GAN.netD,[dlFake;dlC]);
+    scoreRandom = forward(GAN.netD,[dlRandom;dlC]);
+    scoreReal = double(gather(extractdata(scoreReal(:))));
+    scoreFake = double(gather(extractdata(scoreFake(:))));
+    scoreRandom = double(gather(extractdata(scoreRandom(:))));
+    lossD = (binaryCrossEntropyValue(scoreReal,Options.realLabel) + ...
+        binaryCrossEntropyValue(scoreFake,0))/2;
+    lossG = 0;
+    if Options.advWeight > 0
+        lossG = Options.advWeight*binaryCrossEntropyValue( ...
+            scoreFake,Options.realLabel);
+    end
+    dRealAcc = mean(scoreReal >= 0.5);
+    dFakeAcc = mean(scoreFake < 0.5);
+    Row = struct( ...
+        'step',double(step), ...
+        'loss_d',double(lossD), ...
+        'loss_g',double(lossG), ...
+        'd_real_acc',double(dRealAcc), ...
+        'd_fake_acc',double(dFakeAcc), ...
+        'd_bal_acc',double((dRealAcc + dFakeAcc)/2), ...
+        'g_fool_rate',double(mean(scoreFake >= 0.5)), ...
+        'score_real_mean',double(mean(scoreReal)), ...
+        'score_fake_mean',double(mean(scoreFake)), ...
+        'score_random_mean',double(mean(scoreRandom)), ...
+        'random_as_fake_rate',double(mean(scoreRandom < 0.5)));
+end
+
+function loss = binaryCrossEntropyValue(score,target)
+    epsVal = 1e-7;
+    score = max(epsVal,min(1 - epsVal,double(score(:))));
+    target = double(target);
+    loss = -mean(target.*log(score) + (1 - target).*log(1 - score));
+end
+
 function loss = binaryCrossEntropy(score,target)
     epsVal = single(1e-7);
     T = score*0 + single(target);
diff --git a/PlatEMO/Algorithms/Multi-objective optimization/CBS-CGAN/BoundaryWGAN_RC.m b/PlatEMO/Algorithms/Multi-objective optimization/CBS-CGAN/BoundaryWGAN_RC.m
